<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
            <PageTitle>Pagina non trovata — Atelier</PageTitle>
            <div class="empty-state compact">
                <h3>Pagina non trovata</h3>
                <p>La pagina richiesta non esiste.</p>
                <a class="text-btn" href="./">Torna all'armadio</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
